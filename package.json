{
  "name": "internet-plan-cal",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "workspaces": [
    "android/@capacitor/app@latest",
    "console",
    "web"
  ],
  "scripts": {
    "dev:console": "bun run --filter console dev",
    "dev:android": "bun run --filter bun-react-template dev:web",
    "android:sync": "bun run --filter bun-react-template android:sync",
    "android:open": "bun run --filter bun-react-template android:open"
  },
  "peerDependencies": {
    "typescript": "5"
  }
}
